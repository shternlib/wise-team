# Wise Team PoC - Environment variables template
# Copy to .env and fill in real values. .env is gitignored.

# ─── Agno Configuration ─────────────────────────────────────────
# Disable Agno's anonymous telemetry (privacy for PoC + future production)
AGNO_TELEMETRY=false

# ─── LLM Provider API Keys ──────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional - additional providers for E3 multi-model swap tests
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# ─── Wise Team PoC Configuration ────────────────────────────────
# Tenant identifiers for multi-tenancy tests (C category)
WISETEAM_TENANT_PRIMARY=inspark
WISETEAM_TENANT_SECONDARY=dragonfamily-poc

# In++ 2.0 schema validation
WISETEAM_INPP_STRICT_MODE=true

# ─── Database (for Stage 3+ scenarios) ──────────────────────────
# AgentOS uses Postgres for session/memory/trace storage
# DATABASE_URL=postgresql://user:pass@localhost:5432/wiseteam_poc

# ─── Observability ──────────────────────────────────────────────
# OTel exporter endpoint (for trace inspection)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
